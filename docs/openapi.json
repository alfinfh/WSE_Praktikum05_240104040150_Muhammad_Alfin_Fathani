{
  "openapi": "3.1.0",
  "info": {
    "title": "API Katalog Perpustakaan",
    "version": "1.0.0",
    "description": "Praktikum 05 WSE. Data memori hilang setelah restart. Tidak ada autentikasi; hanya untuk localhost. POST dan PUT wajib judul (1-120 karakter setelah trim) dan tersedia (boolean); field tambahan dilarang. Contoh error menggambarkan skenario representatif, kode aktual bisa bervariasi menurut penyebab."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3200"
    }
  ],
  "tags": [
    {
      "name": "Buku",
      "description": "Operasi katalog kampus"
    }
  ],
  "paths": {
    "/api/buku": {
      "get": {
        "tags": [
          "Buku"
        ],
        "summary": "Membaca daftar buku atau mencari judul",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "Satu teks, maksimal 80 unit UTF-16; kosong menampilkan semua.",
            "schema": {
              "type": "string"
            },
            "example": "kotlin"
          }
        ],
        "responses": {
          "200": {
            "description": "Array buku, boleh kosong.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DaftarResponse"
                },
                "example": {
                  "success": true,
                  "data": [
                    {
                      "id": 1,
                      "judul": "Dasar Pemrograman Kotlin",
                      "tersedia": true
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Input tidak sesuai kontrak.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": "INVALID_BOOK",
                    "message": "Input tidak sesuai kontrak."
                  }
                }
              }
            }
          },
          "500": {
            "description": "Terjadi kesalahan pada server.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": "INTERNAL_ERROR",
                    "message": "Terjadi kesalahan pada server."
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Buku"
        ],
        "summary": "Menambah buku",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BukuInput"
              },
              "example": {
                "judul": "Belajar API dengan Express",
                "tersedia": true
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Buku dibuat.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BukuResponse"
                },
                "example": {
                  "success": true,
                  "data": {
                    "id": 3,
                    "judul": "Belajar API dengan Express",
                    "tersedia": true
                  }
                }
              }
            },
            "headers": {
              "Location": {
                "description": "URI buku baru.",
                "schema": {
                  "type": "string"
                },
                "example": "/api/buku/3"
              }
            }
          },
          "400": {
            "description": "Input tidak sesuai kontrak.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": "INVALID_BOOK",
                    "message": "Input tidak sesuai kontrak."
                  }
                }
              }
            }
          },
          "413": {
            "description": "Body melebihi batas 10kb.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": "PAYLOAD_TOO_LARGE",
                    "message": "Body melebihi batas 10kb."
                  }
                }
              }
            }
          },
          "415": {
            "description": "Gunakan Content-Type application/json.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": "UNSUPPORTED_MEDIA_TYPE",
                    "message": "Gunakan Content-Type application/json."
                  }
                }
              }
            }
          },
          "500": {
            "description": "Terjadi kesalahan pada server.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": "INTERNAL_ERROR",
                    "message": "Terjadi kesalahan pada server."
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/buku/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "Digit positif tanpa nol di depan, aman sebagai integer JavaScript.",
          "schema": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "example": "1"
        }
      ],
      "get": {
        "tags": [
          "Buku"
        ],
        "summary": "Membaca detail buku",
        "responses": {
          "200": {
            "description": "Detail buku.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BukuResponse"
                },
                "example": {
                  "success": true,
                  "data": {
                    "id": 1,
                    "judul": "Dasar Pemrograman Kotlin",
                    "tersedia": true
                  }
                }
              }
            }
          },
          "400": {
            "description": "Input tidak sesuai kontrak.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": "INVALID_BOOK",
                    "message": "Input tidak sesuai kontrak."
                  }
                }
              }
            }
          },
          "404": {
            "description": "Buku tidak ditemukan.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": "BOOK_NOT_FOUND",
                    "message": "Buku tidak ditemukan."
                  }
                }
              }
            }
          },
          "500": {
            "description": "Terjadi kesalahan pada server.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": "INTERNAL_ERROR",
                    "message": "Terjadi kesalahan pada server."
                  }
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Buku"
        ],
        "summary": "Mengganti seluruh field buku",
        "description": "Target wajib ada; judul dan tersedia wajib diisi.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BukuInput"
              },
              "example": {
                "judul": "Belajar API dengan Express",
                "tersedia": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Buku diperbarui.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BukuResponse"
                }
              }
            }
          },
          "400": {
            "description": "Input tidak sesuai kontrak.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": "INVALID_BOOK",
                    "message": "Input tidak sesuai kontrak."
                  }
                }
              }
            }
          },
          "404": {
            "description": "Buku tidak ditemukan.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": "BOOK_NOT_FOUND",
                    "message": "Buku tidak ditemukan."
                  }
                }
              }
            }
          },
          "413": {
            "description": "Body melebihi batas 10kb.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": "PAYLOAD_TOO_LARGE",
                    "message": "Body melebihi batas 10kb."
                  }
                }
              }
            }
          },
          "415": {
            "description": "Gunakan Content-Type application/json.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": "UNSUPPORTED_MEDIA_TYPE",
                    "message": "Gunakan Content-Type application/json."
                  }
                }
              }
            }
          },
          "500": {
            "description": "Terjadi kesalahan pada server.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": "INTERNAL_ERROR",
                    "message": "Terjadi kesalahan pada server."
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Buku"
        ],
        "summary": "Menghapus satu buku",
        "responses": {
          "204": {
            "description": "Berhasil; body kosong."
          },
          "400": {
            "description": "Input tidak sesuai kontrak.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": "INVALID_BOOK",
                    "message": "Input tidak sesuai kontrak."
                  }
                }
              }
            }
          },
          "404": {
            "description": "Buku tidak ditemukan.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": "BOOK_NOT_FOUND",
                    "message": "Buku tidak ditemukan."
                  }
                }
              }
            }
          },
          "500": {
            "description": "Terjadi kesalahan pada server.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": "INTERNAL_ERROR",
                    "message": "Terjadi kesalahan pada server."
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BukuInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "judul",
          "tersedia"
        ],
        "properties": {
          "judul": {
            "type": "string",
            "minLength": 1,
            "description": "Setelah trim, panjang 1-120 unit UTF-16."
          },
          "tersedia": {
            "type": "boolean"
          }
        }
      },
      "Buku": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "judul",
          "tersedia"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "judul": {
            "type": "string",
            "minLength": 1,
            "description": "Setelah trim, panjang 1-120 unit UTF-16."
          },
          "tersedia": {
            "type": "boolean"
          }
        }
      },
      "BukuResponse": {
        "type": "object",
        "required": [
          "success",
          "data"
        ],
        "properties": {
          "success": {
            "const": true
          },
          "data": {
            "$ref": "#/components/schemas/Buku"
          }
        }
      },
      "DaftarResponse": {
        "type": "object",
        "required": [
          "success",
          "data"
        ],
        "properties": {
          "success": {
            "const": true
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Buku"
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "success",
          "error"
        ],
        "properties": {
          "success": {
            "const": false
          },
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
